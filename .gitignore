# ============================================================
# 仓库只保留源码、文档与 docs/ 下精选的公开结果。
# 以下内容都可由脚本重新生成，不进入 Git。
# ============================================================

# ---- Python / 编辑器 / 系统缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 运行产物：权重与训练记录（run/）----
/run/*
!/run/.gitkeep
*.pt
*.pth
*.ckpt
/checkpoints/
/change_protection/
/fresnel_runs/

# ---- 运行产物：图片与评估结果（out/）----
/out/*
!/out/.gitkeep

# ---- 数据数组（体积大，由 generate_data.py 生成）----
/data/
/fresnel_data/
*.npy
*.npz

# ---- 本机检查材料与阶段汇报（fresnel_* / reports/）----
/fresnel_checks/
/fresnel_reference/
/fresnel_analysis/
/reports/
/publish_checks/

# ---- 含本机路径的审计/发布快照 ----
/fresnel_experiment/legacy_artifacts_before.json
/fresnel_experiment/verification.json
/fresnel_experiment/IMPLEMENTATION_REPORT.md
/fresnel_experiment/ASM_TIMING_REPORT.md
